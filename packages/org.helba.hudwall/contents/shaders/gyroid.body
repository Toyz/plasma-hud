// Raymarched gyroid lattice: |sin(p).cos(p.zxy)| shell, camera flying down a carved tunnel.
vec2 path(float z) { return vec2(sin(z * 0.31) * 1.3, cos(z * 0.23) * 0.9); }

float gyroid(vec3 p, float s, float th) {
    p *= s;
    return abs(dot(sin(p), cos(p.zxy))) / s - th;
}

float map(vec3 p) {
    float d = gyroid(p, 1.0, 0.07);
    d += gyroid(p + 0.7, 3.3, 0.0) * 0.08;
    float tunnel = length(p.xy - path(p.z)) - 0.75;
    return max(d * 0.7, -tunnel);
}

vec3 normalAt(vec3 p) {
    const vec2 k = vec2(1, -1) * 0.0015;
    return normalize(k.xyy * map(p + k.xyy) + k.yyx * map(p + k.yyx) +
                     k.yxy * map(p + k.yxy) + k.xxx * map(p + k.xxx));
}

void main() {
    vec2 uv = qt_TexCoord0;
    vec2 gp = span.xy + uv * resolution;
    vec2 sp = (gp - span.zw * 0.5) / span.w;
    sp.y = -sp.y;

    float z = time * 0.55 + seed * 40.0;
    vec3 ro = vec3(path(z), z);
    vec3 ta = vec3(path(z + 1.5), z + 1.5);
    vec3 fw = normalize(ta - ro);
    vec3 rt = normalize(cross(vec3(0, 1, 0), fw));
    vec3 up = cross(fw, rt);
    vec3 rd = normalize(sp.x * rt + sp.y * up + 1.1 * fw);
    rd.xy *= rot(sin(time * 0.07) * 0.4);

    float t = 0.0, glow = 0.0;
    float hit = 0.0;
    for (int i = 0; i < 96; i++) {
        vec3 p = ro + rd * t;
        float d = map(p);
        glow += 0.015 / (0.03 + abs(d));
        if (d < 0.0015) { hit = 1.0; break; }
        t += d;
        if (t > 22.0) break;
    }

    vec3 col = vec3(0.0);
    if (hit > 0.5) {
        vec3 p = ro + rd * t;
        vec3 n = normalAt(p);
        float diff = clamp(dot(n, normalize(ro - p)), 0.0, 1.0);
        float band = 0.5 + 0.5 * sin(p.z * 0.9 + gyroid(p, 6.0, 0.0) * 10.0);
        vec3 base = mix(accent.rgb, accent2.rgb, band);
        float rim = pow(1.0 - clamp(dot(n, -rd), 0.0, 1.0), 3.0);
        col = base * (0.15 + diff * 0.9) + accent2.rgb * rim * 0.8;
    }
    float fog = exp(-t * 0.16);
    col *= fog;
    col += accent.rgb * glow * 0.012;

    vec3 img = texture(src, uv).rgb;
    vec3 outc = hasImage > 0.5 ? img * (1.0 - 0.75 * intensity) + col * (0.4 + intensity) : col;
    fragColor = vec4(chromaDrift(vignette(outc, uv), uv, chroma), 1.0) * qt_Opacity;
}
