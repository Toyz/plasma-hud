// Broken signal: block displacement, row tears, RGB split, posterized blocks, roll bar, grain.
void main() {
    vec2 uv = qt_TexCoord0;
    vec2 gp = span.xy + uv * resolution;
    float tq = floor(time * 12.0);
    float burst = step(0.88, hash(vec2(floor(time * 1.5), seed * 91.0)));
    float g = intensity * (0.12 + burst * 0.88);

    vec2 blocks = vec2(32.0, 18.0) * (1.0 + floor(hash(vec2(tq, 3.0)) * 3.0));
    vec2 b = floor(uv * blocks);
    float h = hash(b + tq + seed);
    vec2 off = vec2(0.0);
    if (h > 1.0 - 0.3 * g) off.x = (hash(b * 1.7 + tq) - 0.5) * 0.25 * g;
    float row = floor(uv.y * 90.0);
    if (hash(vec2(row, tq)) > 0.975) off.x += (hash(vec2(row, tq + 1.0)) - 0.5) * 0.15 * g;

    float ca = 0.0015 + 0.006 * g;
    vec2 u2 = uv + off;
    vec3 base;
    if (hasImage > 0.5) {
        base = vec3(texture(src, u2 + vec2(ca, 0)).r, texture(src, u2).g, texture(src, u2 - vec2(ca, 0)).b);
    } else {
        vec2 p = u2 * vec2(resolution.x / resolution.y, 1.0) * 3.0 + seed;
        float f = fbm(p + time * 0.05);
        base = mix(vec3(0.02, 0.02, 0.04), accent.rgb * 0.7, f * f * 1.6);
    }
    if (h > 1.0 - 0.15 * g) base = floor(base * 4.0) / 4.0 * mix(vec3(1.0), accent.rgb * 1.6, 0.5);

    base *= 0.9 + 0.1 * sin(gp.y * 3.14159);
    float roll = fract(uv.y - time * 0.07);
    base += accent.rgb * 0.06 * smoothstep(0.0, 0.02, roll) * smoothstep(0.07, 0.02, roll);
    base += (hash(gp + fract(time) * 100.0) - 0.5) * 0.07 * intensity;
    base = mix(base, base * accent2.rgb * 1.6, smoothstep(0.7, 1.0, luma(base)) * 0.3 * intensity);
    fragColor = vec4(chromaDrift(vignette(base, uv), uv, chroma), 1.0) * qt_Opacity;
}
