// Domain-warped fbm: fbm(p + 4 fbm(p + 4 fbm(p))). The image is pushed around by the warp field.
void main() {
    vec2 uv = qt_TexCoord0;
    vec2 gp = span.xy + uv * resolution;
    vec2 p = gp / resolution.y * 1.6 + seed * 13.0;
    float t = time * 0.06;

    vec2 q = vec2(fbm(p + vec2(0.0, t)), fbm(p + vec2(5.2, 1.3) - t));
    vec2 r = vec2(fbm(p + 3.5 * q + vec2(1.7, 9.2) + 0.45 * t),
                  fbm(p + 3.5 * q + vec2(8.3, 2.8) - 0.38 * t));
    float f = fbm(p + 3.5 * r);

    vec3 col = mix(vec3(0.012, 0.014, 0.03), accent.rgb * 0.6, smoothstep(0.25, 0.95, f));
    col = mix(col, accent2.rgb * 0.85, smoothstep(0.6, 1.2, length(q)) * 0.7);
    col += accent.rgb * pow(smoothstep(0.55, 1.0, r.y), 5.0) * 1.3;
    col *= 0.35 + f * f * 1.6;

    vec3 img = texture(src, uv + (r - 0.5) * 0.02 * intensity).rgb;
    vec3 outc = hasImage > 0.5
        ? mix(img, screenBlend(img * (1.0 - 0.35 * intensity), col), intensity)
        : col;
    fragColor = vec4(chromaDrift(vignette(outc, uv), uv, chroma), 1.0) * qt_Opacity;
}
