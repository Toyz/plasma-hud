// Luma halftone CRT: the image re-set as RGB phosphor dots sized by its own channel
// brightness, on a curved, scanlined tube that breathes.
vec2 curve(vec2 uv, float k) {
    uv = uv * 2.0 - 1.0;
    uv *= 1.0 + dot(uv, uv) * k;
    return uv * 0.5 + 0.5;
}
void main() {
    vec2 uv0 = qt_TexCoord0;
    vec2 uv = curve(uv0, 0.035 * intensity);
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) { fragColor = vec4(0, 0, 0, 1) * qt_Opacity; return; }

    float cell = mix(4.0, 9.0, intensity) * (1.0 + 0.04 * sin(time * 0.5));
    vec2 gp = uv * resolution;
    vec3 col = vec3(0.0);
    for (int ch = 0; ch < 3; ch++) {
        float ang = 0.26 + float(ch) * 0.52;
        mat2 R = rot(ang);
        vec2 q = R * gp / cell;
        vec2 id = floor(q) + 0.5;
        vec2 center = (transpose(R) * (id * cell)) / resolution;
        float v = textureLod(src, center, 1.5)[ch];
        float r = sqrt(clamp(v, 0.0, 1.0)) * 0.62;
        float d = length(fract(q) - 0.5);
        col[ch] = smoothstep(r, r - 0.08, d);
    }
    vec3 base = texture(src, uv).rgb;
    col = mix(base, col * 1.25, intensity);
    col *= 0.88 + 0.12 * sin(gp.y * 3.14159);
    col *= 1.0 - 0.06 * hash(vec2(floor(time * 24.0), 1.0));
    fragColor = vec4(chromaDrift(vignette(col, uv0), uv, chroma), 1.0) * qt_Opacity;
}
