// Hex lens field: every cell refracts the image; interference waves from two drifting
// emitters light the cell walls; random cells flash.
vec4 hexCoords(vec2 p) {
    const vec2 s = vec2(1.0, 1.7320508);
    vec4 hc = floor(vec4(p, p - vec2(0.5, 1.0)) / s.xyxy) + 0.5;
    vec4 h = vec4(p - hc.xy * s, p - (hc.zw + 0.5) * s);
    return dot(h.xy, h.xy) < dot(h.zw, h.zw) ? vec4(h.xy, hc.xy) : vec4(h.zw, hc.zw + 0.5);
}
float hexDist(vec2 p) {
    p = abs(p);
    return max(dot(p, normalize(vec2(1.0, 1.7320508))), p.x);
}

void main() {
    vec2 uv = qt_TexCoord0;
    vec2 gp = span.xy + uv * resolution;
    float scale = 16.0;
    vec2 p = gp / resolution.y * scale;
    vec4 hc = hexCoords(p);
    vec2 local = hc.xy;
    vec2 cell = (p - local) / scale * resolution.y / span.zw;

    vec2 e1 = vec2(0.5 + 0.4 * sin(time * 0.21 + seed * 6.0), 0.5 + 0.35 * cos(time * 0.17));
    vec2 e2 = vec2(0.5 + 0.4 * cos(time * 0.13 + 2.0), 0.5 + 0.35 * sin(time * 0.19 + seed * 3.0));
    float a = span.z / span.w;
    float w = sin(length((cell - e1) * vec2(a, 1.0)) * 28.0 - time * 2.2)
            + sin(length((cell - e2) * vec2(a, 1.0)) * 23.0 - time * 1.7);
    float pulse = pow(clamp(w * 0.5 * 0.5 + 0.5, 0.0, 1.0), 5.0);

    float hd = hexDist(local);
    float wall = smoothstep(0.43, 0.5, hd);
    vec2 lens = local * 0.014 * (0.35 + pulse) * intensity / vec2(resolution.x / resolution.y, 1.0);
    vec3 img;
    if (hasImage > 0.5) {
        float ca = 0.002 * pulse * intensity;
        img = vec3(texture(src, uv - lens + vec2(ca, 0)).r, texture(src, uv - lens).g, texture(src, uv - lens - vec2(ca, 0)).b);
    } else {
        img = mix(vec3(0.015, 0.02, 0.035), accent.rgb * 0.25, fbm(cell * 4.0 + time * 0.03));
    }

    float flick = step(0.992, hash(hc.zw + floor(time * 2.0) + seed));
    vec3 col = img * (0.9 - 0.25 * intensity * wall);
    col += accent.rgb * wall * (0.08 + pulse * 0.9) * intensity;
    col += accent2.rgb * flick * (1.0 - wall) * 0.25 * intensity;
    fragColor = vec4(chromaDrift(vignette(col, uv), uv, chroma), 1.0) * qt_Opacity;
}
