// Living ink: the image flows along the curl of its own luminance (along contours, not across),
// using two crossfaded phase-offset samples so motion is endless without drifting apart.
void main() {
    vec2 uv = qt_TexCoord0;
    vec2 px = 1.0 / resolution;
    vec2 g = gradL(uv, 5.0, px * 32.0);
    vec2 curl = vec2(g.y, -g.x);
    curl += 0.15 * (vec2(noise(uv * 3.0 + time * 0.03 + seed), noise(uv * 3.0 + 5.0 - time * 0.03)) - 0.5) * length(g);
    vec2 flow = curl * 0.22 * intensity;

    float t = time * 0.12;
    float ph0 = fract(t), ph1 = fract(t + 0.5);
    float w = abs(ph0 - 0.5) * 2.0;
    vec3 c0 = texture(src, uv - flow * ph0).rgb;
    vec3 c1 = texture(src, uv - flow * ph1).rgb;
    vec3 col = mix(c0, c1, w);

    // Ink pools: where the field converges, colors deepen and gain sheen.
    float conv = clamp(length(g) * 6.0, 0.0, 1.0);
    vec3 hsv = rgb2hsv(col);
    hsv.y = clamp(hsv.y * (1.0 + 0.35 * conv * intensity), 0.0, 1.0);
    col = hsv2rgb(hsv);
    fragColor = vec4(chromaDrift(col, uv, chroma), 1.0) * qt_Opacity;
}
