// Image-seeded growth display: reaction-diffusion field (seeded from the image's edges)
// rendered as coral built from the image's own colors.
layout(binding = 2) uniform sampler2D field;

void main() {
    vec2 uv = qt_TexCoord0;
    vec2 tx = 1.0 / vec2(textureSize(field, 0));
    float b = texture(field, uv).g;
    float bx = texture(field, uv + vec2(tx.x, 0)).g - texture(field, uv - vec2(tx.x, 0)).g;
    float by = texture(field, uv + vec2(0, tx.y)).g - texture(field, uv - vec2(0, tx.y)).g;
    vec3 n = normalize(vec3(-bx * 5.0, -by * 5.0, 1.0));
    float light = clamp(dot(n, normalize(vec3(-0.4, 0.5, 0.8))), 0.0, 1.0);

    vec3 img = texture(src, uv + vec2(bx, by) * 0.03 * intensity).rgb;
    vec3 hsv = rgb2hsv(textureLod(src, uv, 2.0).rgb);
    vec3 coral = hsv2rgb(vec3(hsv.x, clamp(hsv.y * 1.4 + 0.15, 0.0, 1.0), clamp(hsv.z * 1.2 + 0.2, 0.0, 1.0)));
    coral = coral * (0.35 + light * 0.9) + vec3(pow(light, 24.0) * 0.5);

    float m = smoothstep(0.12, 0.33, b) * intensity;
    fragColor = vec4(chromaDrift(mix(img, coral, m), uv, chroma), 1.0) * qt_Opacity;
}
