// Helba World fastfetch: the gate sigil in gold and cyan beside a short system
// readout. Colors are ANSI names, so the terminal theme (Helba World dark or light
// in Alacritty) decides the exact shades.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/helba-world.txt",
        "color": { "1": "yellow", "2": "cyan" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "yellow", "title": "yellow", "separator": "cyan" },
        "key": { "width": 10 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name}{#cyan} ◇ {#}the world" },
        { "type": "custom", "format": "{#cyan}◆─────────────────────────◆" },
        { "type": "os", "key": "server", "format": "{name} {version-id}" },
        { "type": "kernel", "key": "kernel", "format": "{release}" },
        { "type": "uptime", "key": "online" },
        { "type": "shell", "key": "shell" },
        { "type": "cpu", "key": "core", "format": "{name}" },
        { "type": "gpu", "key": "gpu", "format": "{name}" },
        { "type": "memory", "key": "memory" },
        "break",
        { "type": "custom", "format": "{#yellow}◆ {#cyan}◆ {#blue}◆ {#magenta}◆ {#red}◆ {#green}◆ {#white}◆" }
    ]
}
