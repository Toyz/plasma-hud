# Helba World (GTK 2): Breeze Dark's pixmaps with the Helba World colors. GTK 2 has no
# live colors, so these are the dark scheme's; GTK 2 apps are rare.
gtk-color-scheme = "bg_color:#0b1126\nfg_color:#eaf0fb\nbase_color:#080d1e\ntext_color:#eaf0fb\nselected_bg_color:#1f4a63\nselected_fg_color:#eaf0fb\ntooltip_bg_color:#0b1126\ntooltip_fg_color:#eaf0fb\nlink_color:#b8935a"

include "/usr/share/themes/Breeze-Dark/gtk-2.0/gtkrc"

style "helba-colors" {
    bg[NORMAL]        = @bg_color
    bg[SELECTED]      = @selected_bg_color
    fg[NORMAL]        = @fg_color
    fg[SELECTED]      = @selected_fg_color
    base[NORMAL]      = @base_color
    base[SELECTED]    = @selected_bg_color
    text[NORMAL]      = @text_color
    text[SELECTED]    = @selected_fg_color
}
class "GtkWidget" style "helba-colors"
